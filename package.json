{
  "name": "comnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-comnotes 'vitest run --project rules'",
    "deploy:rules": "grep -q REPLACE_WITH_OWNER_UID firestore.rules && echo 'firestore.rules still has REPLACE_WITH_OWNER_UID. Paste the owner uid first (see README).' >&2 && exit 1; firebase deploy --only firestore:rules"
  },
