rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // uid of the single Firebase Auth user whose password is the PIN (see README)
    function ownerUid() {
      return 'REPLACE_WITH_OWNER_UID';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    match /notes/{noteId} {
      allow read, write: if isOwner();
    }

    // Everything else, including the old pin collection, is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
